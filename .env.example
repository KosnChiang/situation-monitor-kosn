# ============================================================
# AI Fibo Vision Trader - Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed.
# IMPORTANT: LIVE_TRADING must remain "false" for the mock build.
# ============================================================

# Hard safety switches (do NOT change for mock build)
LIVE_TRADING=false
EXECUTION_MODE=mock

# GPU: dual RTX 3090, pin inference to card #1
CUDA_VISIBLE_DEVICES=1

# API
HOST=127.0.0.1
PORT=8765

# Logging
LOG_DIR=logs
TRADES_LOG=logs/trades.jsonl

# Telegram (optional; leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Capture
CAPTURE_MONITOR_INDEX=1

# TradingView webhook (Phase 6.A-4, mock-only)
# Leave TRADINGVIEW_WEBHOOK_SECRET blank to disable the /webhook/tradingview
# endpoint. When set, the endpoint will accept POSTs whose JSON body's
# "secret" field matches via hmac.compare_digest. The secret is NEVER
# written to logs (logs/webhooks.jsonl always shows secret="***").
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_LOG=logs/webhooks.jsonl
# When true, /webhook/tradingview blocks for ApprovalGate up to
# APPROVAL_TIMEOUT_SECONDS before routing. Default false = auto-approve.
TRADINGVIEW_REQUIRE_APPROVAL=false
APPROVAL_TIMEOUT_SECONDS=5
