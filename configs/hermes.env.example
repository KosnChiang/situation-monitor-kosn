# ============================================================
# Hermes environment overlay (mock-only)
#
# Copy to C:\Trading\configs\hermes.env on the Windows box.
# scripts\start_hermes.ps1 reads this file AFTER applying its hard
# mock-mode defaults, and will REFUSE to honour any line that tries to
# flip LIVE_TRADING / EXECUTION_MODE / BROKER_MODE.
# ============================================================

# Mock-mode invariants -- these are also enforced by start_hermes.ps1.
# Listed here so a human reader can see the intended state at a glance.
LIVE_TRADING=false
EXECUTION_MODE=mock
BROKER_MODE=mock

# GPU pinning: only the second RTX 3090.
CUDA_VISIBLE_DEVICES=1

# Project + data roots.
PROJECT_ROOT=C:\Trading\ai_fibo_vision_trader
DATA_ROOT=D:\TradingData

# Ollama backend (qwen2.5:14b must be pulled first: `ollama pull qwen2.5:14b`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Path allowlist consumed by start_hermes.ps1 (project convention).
# NOTE: Hermes Agent (https://github.com/NousResearch/hermes-agent) does
# not document reading this file natively. Treat it as defence-in-depth
# project documentation, not a hard sandbox.
HERMES_ALLOWLIST=C:\Trading\configs\hermes_allowlist.yaml

# Hermes entry point. After the official installer runs
# (`irm https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.ps1 | iex`)
# the `hermes` command is added to PATH and the install lives in
# %LOCALAPPDATA%\hermes. Leave this blank to invoke `hermes` from PATH,
# or set it to an absolute path you have personally verified, e.g.:
#   HERMES_EXEC=%LOCALAPPDATA%\hermes\bin\hermes.exe
HERMES_EXEC=
